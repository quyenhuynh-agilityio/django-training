# .env.example

# Environment selection (optional)
# config/settings/base.py loads:
#   - .env.<env> where <env> is inferred from DJANGO_SETTINGS_MODULE (local/production/test)
#   - or ENV_FILE if provided (relative to project root)
#
# Tip: run commands like:
#   DJANGO_SETTINGS_MODULE=config.settings.production uv run python manage.py runserver
# If set, config/settings/base.py will load this file path (relative to project root)
# ENV_FILE=.env.production
ENV_FILE=

# Django Settings
DEBUG=
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=

# PostgreSQL Database (default)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME
JWT_REFRESH_TOKEN_LIFETIME=

# CORS Settings
CORS_ALLOWED_ORIGINS=

# Email Settings
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
