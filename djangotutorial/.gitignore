# Python Bytecode and Cache Files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Django-Specific Files
*.log  # Log files
*.pot  # Django translation files (if not needed in repo)
*.pyc  # Compiled Python files
media/  # User-uploaded media files (store elsewhere, e.g., S3)
staticfiles/  # Collected static files (generated by collectstatic)

# Database Files (SQLite fallback or local testing)
db.sqlite3  # Exclude SQLite if used as a fallback
*.sql  # SQL dump files (e.g., backups or exports)
*.sql.gz  # Compressed SQL dumps
*.dump  # PostgreSQL dump files (e.g., from pg_dump)

# PostgreSQL-Specific (Local Development)
pgdata/  # Local PostgreSQL data directory (if running locally via Docker or manually)
*.pid  # PostgreSQL lock files (e.g., postmaster.pid)

# Virtual Environment
env/
venv/
ENV/
env.bak/
venv.bak/
*.venv/

# Dependency Management
Pipfile.lock  # Optional: Exclude if reproducible builds handled elsewhere
*.egg-info/
dist/
build/
eggs/
*.egg

# IDE and Editor Files
.idea/  # PyCharm/IntelliJ
*.sublime-project
*.sublime-workspace
.vscode/  # Visual Studio Code
*.swp  # Vim swap files

# OS-Specific Files
.DS_Store  # macOS
Thumbs.db  # Windows

# Testing and Coverage
htmlcov/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Miscellaneous
*.bak
*.backup
*.tmp
*.temp
local_settings.py  # Local config with database credentials
*.env  # Environment variable files with secrets (e.g., DATABASE_URL)
secrets.json  # Alternative secret storage

# Static and Media Directories (if applicable)
static_root/  # Alternative name for collected static files
media_root/  # Alternative name for media files